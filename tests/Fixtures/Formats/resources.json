{
    "publish_tags": {
        "core": {
            "azguard-config": [
                "config/azguard.php => config/azguard.php"
            ],
            "azguard-migrations": [
                "database/migrations => database/migrations"
            ]
        },
        "filament": {
            "azguard-filament-config": [
                "config/azguard-filament.php => config/azguard-filament.php"
            ]
        },
        "audit": {
            "azguard-audit-migrations": [
                "modules/audit/database/migrations => database/migrations"
            ]
        }
    },
    "stub_publish_path": "stubs/azguard",
    "core_migrations": {
        "basenames": [
            "2026_10_01_000000_create_azguard_storage"
        ],
        "loaded_by_provider": true
    },
    "named_storage_migration": "<date>_create_azguard_<storage>_storage.php",
    "audit_migrations": {
        "basenames": [
            "2026_10_20_000000_create_azguard_audit_log"
        ],
        "loaded_by_provider": false
    },
    "named_audit_migration": "<date>_create_azguard_<storage>_audit_log.php",
    "middleware_aliases": {
        "azguard.panel": "AzGuard\\Laravel\\Internal\\Http\\Middleware\\EnterPanel",
        "azguard.can": "AzGuard\\Laravel\\Internal\\Http\\Middleware\\CheckPermission"
    },
    "container_alias": {
        "azguard": "AzGuard\\AzGuard",
        "same_instance": true
    },
    "translation_namespaces": [
        "azguard"
    ],
    "view_namespaces": [
        "azguard-filament"
    ],
    "queue_hidden_context_key": "azguard.panel",
    "plugin_ids": {
        "audit": "azguard/audit"
    },
    "system_actor_type": {
        "constant": "azguard:system",
        "system()": "azguard:system"
    },
    "storage_state_schema_keys": [
        "host_keys",
        "identity_codec",
        "prefix",
        "storage_id",
        "version"
    ],
    "storage_state_schema_default": {
        "host_keys": "string",
        "identity_codec": 1,
        "prefix": "azg_",
        "storage_id": "default",
        "version": 2
    },
    "module_resources": {
        "publish_tag azguard-audit-migrations": true,
        "migration 2026_10_20_000000_create_azguard_audit_log": true,
        "generated migration <date>_create_azguard_<storage>_audit_log.php": true,
        "command azguard:audit:migration": true,
        "plugin id azguard/scopes": true,
        "provider AzGuard\\Audit\\AuditServiceProvider": true,
        "provider AzGuard\\DevTools\\DevToolsServiceProvider": true
    }
}
