                    "definition": "CREATE TRIGGER \"azg_al_tenant_pair_insert\" BEFORE INSERT ON \"azg_audit_log\" WHEN NOT (((NEW.tenant_key = 'global') = (NEW.tenant_type IS NULL AND NEW.tenant_id IS NULL)) AND ((NEW.tenant_type IS NULL) = (NEW.tenant_id IS NULL))) BEGIN SELECT RAISE(ABORT, 'azguard: al_tenant_pair'); END"
