{
    "baseline": "0.7.0",
    "findings": {
        "F1": {
            "summary": "A panel whose effective scope declaration is AssignmentScopePolicy::none() after an earlier scopes() record (here the CRM provider declares inherit(ProjectScope), the panel then declares none()) keeps that record's definitions: PanelCompiler::scopes() merges the definitions of every layered scopes() record while the mode comes from the effective policy. QueryScopeDirectory::search() does not consult the mode and offers project contexts in the Assignment phase; final validation rejects every non-global context (context_not_accepted). Directory eligibility differs from write admission (I9), and without a declaration the directory still offers non-global contexts (I7).",
            "owner_phase": "P2",
            "reported": "plan log PLAN1 P1.3 (finding)"
        },
        "F2": {
            "summary": "QueryScopeDirectory::search() in the Assignment phase offers the contexts of a tenant to a target who is not a member of that tenant (no 0.7.0 directory, subject, tenant or scope, consults tenant membership), while final validation rejects the grant (tenant_mismatch, ChangeValidator::tenancy()). The directory documents that it offers only the contexts the final write would accept for the target, so directory eligibility differs from write admission (I9).",
            "owner_phase": "P2",
            "reported": "plan log PLAN1 P1.3 (finding)"
        }
    },
