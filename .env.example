# Local DB matrix stand (docker-compose.yml) — copy to .env and adjust if needed.
# Not consumed by the package itself; used by `make up`/`down` and, from P4.2 on,
# by the composer test:pgsql/test:mysql scripts to point Testbench at these services.

PGSQL_PORT=5432
PGSQL_DATABASE=azguard_test
PGSQL_USERNAME=azguard
PGSQL_PASSWORD=azguard

MYSQL_PORT=3306
MYSQL_DATABASE=azguard_test
MYSQL_USERNAME=azguard
MYSQL_PASSWORD=azguard
MYSQL_ROOT_PASSWORD=azguard

REDIS_PORT=6379
