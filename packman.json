{
    "$schema": "../packman/schemas/packman.schema.json",
    "schema_version": 1,
    "name": "axiomasoft/azguard-monorepo",
    "profile": "laravel-package",
    "php": ">=8.4 <8.6",
    "phpstan_level": "max",
    "provider_max_lines": 80,
    "packages": [
        {
            "name": "axiomasoft/azguard",
            "path": "packages/core",
            "namespace": "AzGuard\\",
            "profile": "laravel-package",
            "layer": "L2",
            "type": "capability",
            "owns": [
                "Attributes",
                "Authorization",
                "Catalog",
                "Changes",
                "Concerns",
                "Configuration",
                "Context",
                "Contracts",
                "Diagnostics",
                "Directories",
                "Errors",
                "Events",
                "Exceptions",
                "Extensions",
                "Facades",
                "Kernel",
                "Laravel",
                "Panels",
                "Permissions",
                "Plugins",
                "Policies",
                "Registrars",
                "Roles",
                "Schema",
                "Sources",
                "Storage",
                "Support",
                "Tenancy",
                "Testing"
            ]
        }
    ]
}
