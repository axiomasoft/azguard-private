<?xml version="1.0" encoding="UTF-8"?>
<!-- Source: anonymized production Laravel project -->
<!-- Separate config for Dusk: php artisan dusk uses phpunit.dusk.xml,
     regular tests - phpunit.xml. Do not mix testsuites. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Browser">
            <directory suffix="Test.php">tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Test database isolation app_test (pattern: name_applications + _test).
             force="true" required: otherwise values from .env.dusk.local
             will kill the test database and migrate:fresh will go through the working database.
             Actual credits Dusk (APP_URL, DUSK_*) — from .env.dusk.local. -->
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="app_test"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="app_test" force="true"/>
        <!-- Sessions and queues must be visible to both the test and artisan serve. -->
        <env name="SESSION_DRIVER" value="file" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
