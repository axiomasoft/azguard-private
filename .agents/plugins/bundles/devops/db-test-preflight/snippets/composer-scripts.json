// Source: anonymized production project
// Fragment composer.json: pre-flight test database built in before launch suite.
// @db:preflight calls shell-script (see snippets/preflight.sh), then tests.
// With non-zero script code composer breaks the chain - suite by dev/prod does not start.
{
  "scripts": {
    "db:preflight": [
      "@php -r \"exit((int) (passthru('bash bin/db-test-preflight.sh', $c) === false ? 1 : $c));\""
    ],
    "test:preflight": [
      "bash bin/db-test-preflight.sh"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@test:preflight",
      "@php artisan test --compact"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "@test"
    ]
  },

  "//_git_hook": [
    "The same pre-flight in git-hook pre-push — tests will not go to remote in red/incorrect database.",
    "File .husky/pre-push (or .git/hooks/pre-push, chmod +x):",
    "",
    "  #!/usr/bin/env bash",
    "  set -euo pipefail",
    "  # docker-default mode; MODE=host for host Postgres",
    "  bash bin/db-test-preflight.sh",
    "  composer test"
  ]
}
