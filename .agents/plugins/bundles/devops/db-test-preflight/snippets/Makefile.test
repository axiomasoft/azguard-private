# Source: anonymized production project
# Fragment Makefile: pre-flight test database as target dependency test.
# From root: make -f docker/Makefile <target> or via delegating root Makefile.
# Compose with .env applications + .env.docker (host ports and docker-specific).

ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
COMPOSE  := docker compose --project-directory $(ROOT_DIR) --env-file $(ROOT_DIR)/.env --env-file $(ROOT_DIR)/.env.docker
DB_SERVICE  := pgsql
APP_SERVICE := app

.PHONY: test-preflight test test-php

# Pre-flight: container raised -> name gate *_test -> pg_isready -> existence/creating a database.
# The name of the test database is pulled from phpunit.xml (the source of truth is the test environment, not .env).
# Heavy psql-put the logic into bin/db-test-preflight.sh (see snippets/preflight.sh),
# so as not to struggle with shielding inside Makefile-recipe.
test-preflight:
	@$(COMPOSE) ps
	@TEST_DB=$$(grep -oP '<env name="DB_DATABASE" value="\K[^"]+' phpunit.xml | head -n1); \
	  case "$$TEST_DB" in \
	    *_test) echo "preflight: test database = $$TEST_DB" ;; \
	    *) echo "PREFLIGHT BLOCKER: '$$TEST_DB' does not end with _test"; exit 1 ;; \
	  esac
	@$(COMPOSE) exec -T $(DB_SERVICE) sh -lc 'pg_isready -U "$$POSTGRES_USER" -d "$$POSTGRES_DB"'
	@MODE=docker bash $(ROOT_DIR)/bin/db-test-preflight.sh

# test depends on pre-flight: without green DB suite does not start.
test: test-preflight test-php

test-php:
	$(COMPOSE) exec -T $(APP_SERVICE) php artisan test --compact
