# Source: anonymized production Laravel project
# Root delegate Makefile: all docker-logic in docker/Makefile,
# but any command (make up, make migrate, make test) runs from the root of the repo.
MAKEFLAGS += --no-print-directory

.PHONY: help
help:
	@echo "Docker: targets from docker/Makefile (make up, make migrate, ...)."
	@$(MAKE) -f docker/Makefile help

# Catch-all: any unknown target is delegated to docker/Makefile
%:
	@$(MAKE) -f docker/Makefile $@
