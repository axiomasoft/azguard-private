# Source: anonymized production Laravel project
# All-in-one image: PHP-FPM + Nginx (serversideup), production-ready.
# One image for app/queue/scheduler/reverb/vite — differs only command in compose.
FROM serversideup/php:8.3-fpm-nginx

USER root

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    libicu-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libmagickwand-dev \
    libpq-dev \
    libzip-dev \
    # Node.js + pnpm — if frontend (vite) works from the same image
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pnpm \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install intl bcmath gd exif sockets pcntl pdo_pgsql pgsql zip \
    && pecl install imagick \
    && docker-php-ext-enable imagick \
    && if ! php -m | grep -qi '^redis$'; then pecl install redis && docker-php-ext-enable redis; fi \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

# Catalogs Laravel, which must exist before the first launch
RUN mkdir -p storage/framework/sessions \
    storage/framework/views \
    storage/framework/cache \
    bootstrap/cache \
    && chown -R www-data:www-data /var/www/html

# Custom nginx-config (root public/, fastcgi on 127.0.0.1:9000, port 8080)
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Hook entrypoint.d: is automatically executed when the container starts (see entrypoint-hook.sh)
COPY docker/php/entrypoint.d/20-init-media-permissions.sh /etc/entrypoint.d/20-init-media-permissions.sh
RUN chmod +x /etc/entrypoint.d/20-init-media-permissions.sh

USER www-data

# Healthcheck is hung in docker-compose on Laravel-endpoint /up:
#   test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8080/up >/dev/null || exit 1"]
#   interval: 10s / timeout: 5s / retries: 5 / start_period: 40s
