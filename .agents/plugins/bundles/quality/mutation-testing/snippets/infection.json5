// Source: anonymized production project
{
    "$schema": "https://infection.github.io/schema.json",

    // Source directories for mutation.
    // In the package/monorepos list all src; in a simple application - one "src".
    "source": {
        "directories": [
            "packages/core/src",
            "packages/api/src"
        ],
        // Eliminate entry points and declarative/generated code:
        // mutations there produce noise, not a signal about the quality of tests.
        "excludes": [
            "Commands",        // CLI-commands: logic is tested in services
            "Facades",         // thin static proxies
            "*/Database/Migrations/*",
            "*/Filament/*"     // declarative UI admin
        ]
    },

    "testFramework": "pest",
    // Generating XML-coating required Infection (Xdebug/PCOV must be enabled).
    "testFrameworkOptions": "--coverage-xml=build/coverage/coverage-xml --log-junit=build/coverage/junit.xml",

    "timeout": 10,   // seconds per mutant - protection against mutation cycling
    "threads": 4,    // default concurrency; flag --threads overlaps

    // Test quality gates. CI crashes if MSI below.
    // Covered MSI more strictly general: we expect high-quality assertions from the covered code.
    "minMsi": 70,
    "minCoveredMsi": 80,

    // Reports: text — list escaped mutants for parsing, html — navigation,
    // summary — aggregates, json — machine processing.
    "logs": {
        "text": "build/infection.log",
        "html": "build/infection.html",
        "summary": "build/infection-summary.log",
        "json": "build/infection.json"
    },

    // Mutator profile: starting with @default, add specific ones point by point.
    // Extra/equivalent mutators are turned off as "Name": false, rather than including everything.
    "mutators": {
        "@default": true,
        "UnwrapArrayFilter": true,
        "MethodCallRemoval": true
    }
}
