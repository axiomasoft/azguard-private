includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - packages/core/src
    - packages/filament/src
    - tests/Fixtures/Visibility/VisibilityProject.php
    - tests/Fixtures/Concerns/Member.php
    - tests/Fixtures/Contracts/Probes
    - tests/Fixtures/Testing/KitCase.php

  excludePaths:
    - legacy

  level: 8

  checkModelProperties: true
  checkPhpDocMissingReturn: true
  reportUnmatchedIgnoredErrors: true
