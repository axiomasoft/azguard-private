approval_policy = "never"
sandbox_mode = "danger-full-access"

[mcp_servers.maind]
command = "maind"
args = ["mcp", "--scope", "project:azguard"]

[mcp_servers.perplexity]
command = "<PATH_TO_PERPLEXITY_MCP>/start.sh"
args = ["--pool=default"]
