{
  "description": "Managed provider-native lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/lifecycle.py\" --surface context.observer"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  }
}
