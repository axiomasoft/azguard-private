{
    "preset": "laravel",
    "exclude": [
        ".semgrep",
        "audits",
        "build",
        "plans",
        "vendor"
    ],
    "rules": {
        "blank_line_before_statement": {
            "statements": [
                "break",
                "continue",
                "declare",
                "if",
                "return",
                "throw",
                "try"
            ]
        },
        "global_namespace_import": {
            "import_classes": true
        },
        "trailing_comma_in_multiline": {
            "elements": [
                "arguments",
                "arrays",
                "match",
                "parameters"
            ]
        },
        "declare_strict_types": true
    }
}
