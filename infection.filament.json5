{
    "$schema": "https://infection.github.io/schema.json",
    "source": {
        "directories": [
            "packages/filament/src"
        ],
        "excludes": [
            // Console entrypoints are declarative; their behavior is covered through services.
            "Commands",
            // Filament resources declare framework wiring rather than domain logic.
            "Resources",
            // Filament pages are declarative UI adapters, not unit-testable domain behavior.
            "Pages"
        ]
    },
    "phpUnit": {
        "customPath": "vendor/bin/pest"
    },
    "logs": {
        "text": "build/infection/filament.log",
        "html": "build/infection/filament.html",
        "summary": "build/infection/filament-summary.log"
    },
    "minMsi": 60,
    "minCoveredMsi": 75,
    "testFramework": "phpunit",
    "mutators": {
        "@default": true
    }
}
