digraph decision_parity {
  rankdir=TB;
  graph [bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#5f7898", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
  edge [color="#64748b", fontname="DejaVu Sans", fontsize=9];
  input [label="Panel, tenant, subject Model/ref,\npermission, scope/resource"];
  normalize [label="Общие validated inputs и\nтипосохраняющая identity"];
  structure [label="Общие structural resolve и проверка\nownership"];
  rules [label="Общие правила qualification, authority\nи conditions"];
  snapshot [label="Authority read: snapshot, revision,\nsource failures"];
  scalar [label="Scalar: конкретный resource и все\nmatching grants"];
  batch [label="Batch: те же inputs; только корректная\nдедупликация"];
  sql [label="SQL: точное row-dependent\nпредставление правил"];
  decision [label="Decision: allow / deny / failure"];
  query [label="Builder фильтруется до count и\npagination"];
  unsupported [label="Явный unsupported; исходный Builder\nнеизменён"];
  directory [label="Directory: structural + собственная\nassignment eligibility"];
  input -> normalize [label=""];
  normalize -> structure [label=""];
  structure -> rules [label=""];
  snapshot -> rules [label="данные и ошибки источников"];
  rules -> scalar [label=""];
  rules -> batch [label=""];
  rules -> sql [label=""];
  scalar -> decision [label=""];
  batch -> decision [label="для каждого запроса"];
  sql -> query [label="точность представима"];
  sql -> unsupported [label="точность не представима"];
  structure -> directory [label="тот же structural contract"];
}
