digraph freeze_workflow {
  rankdir=TB;
  graph [bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#5f7898", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
  edge [color="#64748b", fontname="DejaVu Sans", fontsize=9];
  findings [label="Контрпримеры R01–R18 и последние plan\ndecisions"];
  fixes [label="W1–W3: ограниченные fixes и behavioral\nregressions"];
  surface [label="W4: выбрать финальные публичные\nконтракты"];
  guard [label="W5–W6: усилить comparator, checks,\ndocs и fixtures"];
  generate [label="Owning generators и freshness checks"];
  candidate [label="Назвать конкретный candidate SHA"];
  qualify [label="Qualification этого SHA +\nLaravel11/PostgreSQL R1"];
  evidence [label="Актуальные evidence, independent\nreview и handoff"];
  freeze [label="Различить comparison baseline,\nqualified SHA и release SHA"];
  owner [label="Владелец принимает решение о tag /\nsplit / publish"];
  findings -> fixes [label=""];
  fixes -> surface [label=""];
  surface -> guard [label=""];
  guard -> generate [label=""];
  generate -> candidate [label="production и validation готовы"];
  candidate -> qualify [label=""];
  qualify -> evidence [label="обязательные checks пройдены"];
  evidence -> freeze [label="непроверенного diff нет"];
  freeze -> owner [label="D27; отдельное решение"];
}
