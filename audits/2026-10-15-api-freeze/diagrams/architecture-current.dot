digraph architecture_current {
  rankdir=LR;
  graph [bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#5f7898", fontname="DejaVu Sans", fontsize=11, margin="0.15,0.10"];
  edge [color="#64748b", fontname="DejaVu Sans", fontsize=9];
  app [label="Приложение: модели, enums, роли,\npolicies"];
  api [label="Core API: panel / subject / decision /\nchanges"];
  auth [label="Core: scalar, batch, SQL authorization"];
  kernel [label="Core Kernel: identities, scope\nalgebra, values"];
  writer [label="Core: единственный authority writer"];
  sources [label="Source SPI: Database / Folder / Gate /\nRelation"];
  scopes [label="Scopes: eligibility и scope\ndirectories"];
  audit [label="Audit: participant и собственный\nжурнал"];
  tools [label="DevTools: scaffolding и команды"];
  filament [label="Filament: UI, guards, inventory,\neditor"];
  app -> api [label="вызывает"];
  filament -> api [label="использует API/SPI"];
  tools -> api [label="использует API/SPI"];
  api -> auth [label="выполняет решения"];
  api -> writer [label="выполняет изменения"];
  auth -> kernel [label="интерпретирует"];
  writer -> kernel [label="валидирует"];
  auth -> sources [label="читает authority"];
  scopes -> api [label="реализует SPI"];
  audit -> writer [label="участвует через ограниченный SPI"];
}
