flowchart TB
  input["Panel, tenant, subject Model/ref, permission, scope/resource"]
  normalize["Общие validated inputs и типосохраняющая identity"]
  structure["Общие structural resolve и проверка ownership"]
  rules["Общие правила qualification, authority и conditions"]
  snapshot["Authority read: snapshot, revision, source failures"]
  scalar["Scalar: конкретный resource и все matching grants"]
  batch["Batch: те же inputs; только корректная дедупликация"]
  sql["SQL: точное row-dependent представление правил"]
  decision["Decision: allow / deny / failure"]
  query["Builder фильтруется до count и pagination"]
  unsupported["Явный unsupported; исходный Builder неизменён"]
  directory["Directory: structural + собственная assignment eligibility"]
  input --> normalize
  normalize --> structure
  structure --> rules
  snapshot -->|"данные и ошибки источников"| rules
  rules --> scalar
  rules --> batch
  rules --> sql
  scalar --> decision
  batch -->|"для каждого запроса"| decision
  sql -->|"точность представима"| query
  sql -->|"точность не представима"| unsupported
  structure -->|"тот же structural contract"| directory
