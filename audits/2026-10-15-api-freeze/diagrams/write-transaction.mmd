flowchart TB
  request["Public Change API: panel, tenant, subject, actor"]
  tx["Writer transaction: lock panel_state"]
  read["Свежие reads и план изменений"]
  pipes["Changing pipes с guarded continuation"]
  validate["Final validation под lock"]
  write["Core writer: authority rows и state/revisions"]
  participant["Participants: append-only собственные rows"]
  commit["Root commit"]
  events["After-commit события"]
  rollback["При ошибке: rollback rows/state; событий нет"]
  ownership["R03: канонический table id до выдачи capability"]
  target["R04: descriptor указывает тот же physical storage"]
  request --> tx
  tx --> read
  read -->|"каждый planned Change"| pipes
  pipes --> validate
  validate --> write
  write -->|"effects всей операции"| participant
  participant --> commit
  commit -->|"только committed effects"| events
  validate -->|"ошибка до commit"| rollback
  participant -->|"ошибка до commit"| rollback
  ownership -->|"требуемое усиление"| participant
  target -->|"требуемое согласование consumers"| tx
