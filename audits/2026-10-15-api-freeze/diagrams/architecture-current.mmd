flowchart LR
  app["Приложение: модели, enums, роли, policies"]
  api["Core API: panel / subject / decision / changes"]
  auth["Core: scalar, batch, SQL authorization"]
  kernel["Core Kernel: identities, scope algebra, values"]
  writer["Core: единственный authority writer"]
  sources["Source SPI: Database / Folder / Gate / Relation"]
  scopes["Scopes: eligibility и scope directories"]
  audit["Audit: participant и собственный журнал"]
  tools["DevTools: scaffolding и команды"]
  filament["Filament: UI, guards, inventory, editor"]
  app -->|"вызывает"| api
  filament -->|"использует API/SPI"| api
  tools -->|"использует API/SPI"| api
  api -->|"выполняет решения"| auth
  api -->|"выполняет изменения"| writer
  auth -->|"интерпретирует"| kernel
  writer -->|"валидирует"| kernel
  auth -->|"читает authority"| sources
  scopes -->|"реализует SPI"| api
  audit -->|"участвует через ограниченный SPI"| writer
