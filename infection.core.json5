{
    "$schema": "https://infection.github.io/schema.json",
    "source": {
        "directories": [
            "packages/core/src"
        ],
        "excludes": [
            // Console entrypoints are declarative; their behavior is covered through services.
            "Commands",
            // Facades are thin static proxies without independent domain behavior.
            "Facades"
        ]
    },
    "phpUnit": {
        "customPath": "bin/infection-pest"
    },
    "logs": {
        "text": "build/infection/core.log",
        "html": "build/infection/core.html",
        "summary": "build/infection/core-summary.log"
    },
    "minMsi": 70,
    "minCoveredMsi": 80,
    "testFramework": "phpunit",
    "mutators": {
        "@default": true
    }
}
