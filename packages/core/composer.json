{
    "name": "axiomasoft/azguard",
    "description": "Panel-based authorization for Laravel: permission sources, explicit policy authority, scoped assignments",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authorization",
        "permissions",
        "roles",
        "rbac",
        "access-control",
        "gate"
    ],
    "homepage": "https://github.com/axiomasoft/azguard",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/azguard/issues",
        "source": "https://github.com/axiomasoft/azguard"
    },
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/log": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "suggest": {
        "dragonmantank/cron-expression": "Required to validate cron expressions and run Laravel scheduled maintenance without laravel/framework."
    },
    "autoload": {
        "psr-4": {
            "AzGuard\\": "src/",
            "AzGuard\\Scopes\\": "modules/scopes/src/",
            "AzGuard\\Audit\\": "modules/audit/src/",
            "AzGuard\\DevTools\\": "modules/devtools/src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "AzGuard\\AzGuardServiceProvider",
                "AzGuard\\Audit\\AuditServiceProvider",
                "AzGuard\\DevTools\\DevToolsServiceProvider"
            ]
        }
    }
}
