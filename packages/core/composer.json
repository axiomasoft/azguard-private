{
    "name": "axiomasoft/azguard",
    "description": "Panel-based authorization for Laravel: permission sources, explicit policy authority, scoped assignments",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "authorization",
        "permissions",
        "roles",
        "rbac",
        "access-control",
        "gate"
    ],
    "homepage": "https://github.com/axiomasoft/azguard",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "email": "dv.vostrikov@gmail.com",
        "issues": "https://github.com/axiomasoft/azguard/issues",
        "security": "https://github.com/axiomasoft/azguard-private/blob/main/SECURITY.md",
        "source": "https://github.com/axiomasoft/azguard"
    },
    "require": {
        "php": "^8.4",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "dragonmantank/cron-expression": "Required to validate cron expressions and run Laravel scheduled maintenance without laravel/framework."
    },
    "autoload": {
        "psr-4": {
            "AzGuard\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": [
                "AzGuard\\AzGuardServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "capability",
            "stability": "stable",
            "error-prefix": "azguard",
            "owns": [
                "Attributes",
                "Authorization",
                "Catalog",
                "Changes",
                "Concerns",
                "Configuration",
                "Context",
                "Contracts",
                "Diagnostics",
                "Directories",
                "Errors",
                "Events",
                "Exceptions",
                "Extensions",
                "Facades",
                "Kernel",
                "Laravel",
                "Panels",
                "Permissions",
                "Plugins",
                "Policies",
                "Registrars",
                "Roles",
                "Schema",
                "Sources",
                "Storage",
                "Support",
                "Tenancy",
                "Testing"
            ]
        }
    }
}
