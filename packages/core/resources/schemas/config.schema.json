                        }
                    },
                    "additionalProperties": false
                },
                "ids": {
                    "type": "object",
                    "properties": {
                        "host_keys": {
                            "type": "string",
                            "default": "string"
                        }
                    },
                    "additionalProperties": false
                },
                "panels": {
                    "type": "object",
                    "properties": {
                        "providers": {
                            "type": [
                                "array",
                                "object"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "schedule": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "default": true
                        },
                        "prune_expired": {
                            "type": "string",
                            "default": "daily"
                        }
                    },
                    "additionalProperties": false
                },
                "sources": {
                    "type": [
                        "array",
                        "object"
                    ]
                },
                "storages": {
                    "type": "object",
                    "properties": {
                        "default": {
                            "type": "object",
                            "properties": {
                                "connection": {
                                    "type": [
                                        "string",
                                        "integer",
                                        "number",
                                        "boolean",
                                        "null"
                                    ],
                                    "default": null
                                },
                                "host_keys": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "default": null
                                },
                                "table_prefix": {
                                    "type": "string",
                                    "default": "azg_"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
