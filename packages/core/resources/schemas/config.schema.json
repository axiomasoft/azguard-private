                        "max_memo_entries": {
                            "type": "integer",
                            "default": 1024
                        },
                        "max_state_entries": {
                            "type": "integer",
                            "default": 1024
                        },
                        "namespace": {
                            "type": [
                                "string",
                                "integer",
                                "number",
                                "boolean",
                                "null"
                            ],
                            "default": null
                        },
                        "previous_keys": {
                            "type": [
                                "array",
                                "object"
                            ]
                        },
                        "signing_key": {
                            "type": [
                                "string",
                                "integer",
                                "number",
                                "boolean",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "catalog": {
                    "type": "object",
                    "properties": {
                        "build_id": {
                            "type": [
                                "string",
                                "integer",
                                "number",
                                "boolean",
                                "null"
                            ],
                            "default": null
                        },
                        "cache_path": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "decision_sets": {
                    "type": "object",
                    "properties": {
                        "max_subjects": {
                            "type": "integer",
                            "default": 500
                        }
                    },
                    "additionalProperties": false
                },
                "defaults": {
                    "type": "object",
                    "properties": {
                        "cache": {
                            "type": "object",
                            "properties": {
                                "generation": {
                                    "type": "integer",
                                    "default": 1
                                },
                                "store": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "default": null
                                },
                                "ttl": {
                                    "type": "integer",
                                    "default": 300
                                }
                            },
                            "additionalProperties": false
                        },
                        "consistency": {
                            "type": "object",
