                                    "type": "string",
                                    "default": "request"
                                }
                            },
                            "additionalProperties": false
                        },
                        "models": {
                            "type": "object",
                            "properties": {
                                "permission": {
                                    "type": [
                                        "string",
                                        "integer",
                                        "number",
                                        "boolean",
                                        "array",
                                        "object",
                                        "null"
                                    ]
                                },
                                "permission_grant": {
                                    "type": [
                                        "string",
                                        "integer",
                                        "number",
                                        "boolean",
                                        "array",
                                        "object",
                                        "null"
                                    ]
                                },
                                "role_grant": {
                                    "type": [
                                        "string",
                                        "integer",
                                        "number",
                                        "boolean",
                                        "array",
                                        "object",
                                        "null"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        },
                        "resource_prefix": {
                            "type": "boolean",
                            "default": true
                        },
                        "scopes": {
                            "type": "object",
                            "properties": {
                                "resolvers": {
                                    "type": [
                                        "array",
                                        "object"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        },
                        "tenants": {
                            "type": "object",
                            "properties": {
                                "resolvers": {
                                    "type": [
                                        "array",
                                        "object"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        },
                        "trace_decisions": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    "additionalProperties": false
                },
                "discovery": {
                    "type": "object",
                    "properties": {
                        "abilities": {
                            "type": "string",
                            "default": "Abilities"
                        },
                        "permissions": {
                            "type": "string",
                            "default": "Permissions"
                        },
                        "policies": {
                            "type": "string",
                            "default": "Policies"
                        },
                        "queries": {
                            "type": "string",
                            "default": "Queries"
                        },
                        "roles": {
                            "type": "string",
                            "default": "Roles"
                        },
                        "scopes": {
                            "type": "string",
                            "default": "Scopes"
                        },
                        "shared": {
                            "type": "string",
                            "default": "Shared"
                        }
                    },
                    "additionalProperties": false
                },
                "gate": {
                    "type": "object",
                    "properties": {
