{
    "name": "axiomasoft/azguard-filament",
    "description": "Filament 5 editors and authorization enforcement for AzGuard panels, built on Packman Filament",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "authorization",
        "permissions",
        "roles",
        "admin"
    ],
    "homepage": "https://github.com/axiomasoft/azguard",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "email": "dv.vostrikov@gmail.com",
        "issues": "https://github.com/axiomasoft/azguard/issues",
        "security": "https://github.com/axiomasoft/azguard-private/blob/main/SECURITY.md",
        "source": "https://github.com/axiomasoft/azguard"
    },
    "require": {
        "php": "^8.4",
        "axiomasoft/azguard": "^2.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-filament": "^0.1",
        "axiomasoft/packman-plugins": "^0.1.1",
        "filament/filament": "^5.8.4"
    },
    "autoload": {
        "psr-4": {
            "AzGuard\\Filament\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": [
                "AzGuard\\Filament\\AzGuardFilamentServiceProvider"
            ]
        },
        "packman": {
            "schema-version": 1,
            "package-type": "integration",
            "stability": "stable",
            "owns": [
                "Attributes",
                "Authorization",
                "Exports",
                "Extensions",
                "Pages",
                "Sources"
            ]
        }
    }
}
