{
    "name": "axiomasoft/azguard-filament",
    "description": "Filament 5 editors for AzGuard panels, built from the panel schema",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "authorization",
        "permissions",
        "roles",
        "admin"
    ],
    "homepage": "https://github.com/axiomasoft/azguard",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/axiomasoft/azguard/issues",
        "source": "https://github.com/axiomasoft/azguard"
    },
    "require": {
        "php": "^8.3",
        "axiomasoft/azguard": "self.version",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "AzGuard\\Filament\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "AzGuard\\Filament\\AzGuardFilamentServiceProvider"
            ]
        }
    }
}
