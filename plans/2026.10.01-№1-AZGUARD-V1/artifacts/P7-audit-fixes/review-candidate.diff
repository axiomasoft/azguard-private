+    expect(DB::table('azg_role_grants')->count())->toBe($rows)
+        ->and(storageVersion('default'))->toBe($version);
+});
+
+it('V62 leaves the rules of a field to the writer, which refuses a value that breaks them', function (): void {
+    $this->bootFilament();
