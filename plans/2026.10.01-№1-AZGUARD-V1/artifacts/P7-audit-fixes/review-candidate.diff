+    {
+        $panel->id('tenanted')->path('tenanted')->authGuard('web');
+        $plugin = AzGuardPlugin::make()->guardPanel('teams')
+            ->formExtensions(...FilamentFixture::$formExtensions['tenanted'] ?? [])
