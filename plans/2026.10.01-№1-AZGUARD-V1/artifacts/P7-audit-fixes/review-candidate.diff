+    AzGuard::panel('teams')->inTenant(TenantRef::of('team', 8))->for($receiver)->grantRole('member');
+
+    return [GrantWorld::memberGrant(2, 'teams', 7), GrantWorld::memberGrant(2, 'teams', 8)];
+}
