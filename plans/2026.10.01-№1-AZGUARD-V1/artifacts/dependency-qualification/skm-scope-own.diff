+    def test_scoped_lint_keeps_historical_write_site_visible_without_gating(self):
+        diag = plan_lint.Diagnostics(selected_items={"P4.5", "P0.2"})
+        message = ("item P0.1: closed «🟢 Done» without printed boundary codes "
+                   "pre_mutation/pre_final in Completion Notes")
+        diag.error(self.plan / "phases/P0/P0.md", 12, message)
+        self.assertTrue(diag.ok)
+        self.assertEqual(len(diag.warnings), 1)
+        self.assertIn("OUT_OF_SCOPE_ITEM_NON_GATING: " + message, diag.warnings[0])
+        self.assertEqual(diag._raw_warnings, [(self.plan / "phases/P0/P0.md",
+                                              "OUT_OF_SCOPE_ITEM_NON_GATING: " + message)])
+        fleet = plan_lint.Diagnostics()
+        fleet.error(self.plan / "phases/P0/P0.md", 12, message)
+        self.assertFalse(fleet.ok)
