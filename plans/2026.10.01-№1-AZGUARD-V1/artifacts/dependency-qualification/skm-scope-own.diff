+    def test_scoped_lint_preserves_every_selected_dependency_and_plan_wide_error(self):
+        selected = {"P4.5", *(f"P1.{index}" for index in range(1, 29))}
+        diag = plan_lint.Diagnostics(selected_items=selected)
+        for item in sorted(selected):
+            diag.error(self.plan / "phases/P1/P1.md", None,
+                       f"item {item}: pre_final: block:VALIDATION_RECEIPT_MISSING at status «🟢 Done»")
+        plan_wide = ("journal schema invalid", "handoff references P0.1 but has no native launch",
+                     "item P0.1: conflicts with selected dependency P1.1")
+        for message in plan_wide:
