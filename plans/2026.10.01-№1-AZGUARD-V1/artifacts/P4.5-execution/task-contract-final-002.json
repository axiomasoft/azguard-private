    "supersedes": null
  },
  "goal": {
    "outcome": "Дать панели встроенный источник ролей из связей моделей хоста без таблиц AzGuard: `RelationSource::make(model, via, role, scope)` превращает членство субъекта в сущности (pivot-роль, статичная роль или замыкание) в scoped `RoleContribution` известной PHP-роли, а для видимости отдаёт выбор сущностей через ту же связь (`FiltersQueries`).",
    "non_goals": [
      "Tenant-резолвинг сущности через `TenantPolicy`/`ModelAssignmentScopeDefinition` и фильтры областей (P4.6 — здесь tenant через resolve/ResolvedAssignmentScope",
      "tenantOf лишь queryable subtype)",
      "исполнение выбора в SQL видимости (P4.12)",
      "doctor `panels.relations` (P6.4)",
      "revision-контракт Stable (P4.8 — здесь только Request)."
    ]
  },
  "must": [
    {
      "id": "M1",
      "requirement": "`@api` `Sources\\Relation\\RelationSource implements ProvidesRoleGrants, FiltersQueries, DescribesSchema` с `make(string|AssignmentScopeDefinition $model, string $via, string|Closure $role, ?Closure $scope = null)`, внутренний `Sources\\Relation\\RelationBinding` (нормализованная конфигурация)",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M2",
      "requirement": "`$model` — класс Eloquent-модели или `AssignmentScopeDefinition` (тогда модель и `type` берутся из определения)",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M3",
      "requirement": "`role` — имя роли (`'owner'`), путь атрибута pivot (`'pivot.role'`) или `Closure($pivot|$related): ?string`",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M4",
      "requirement": "`id()` — `relation:<type>`",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M5",
      "requirement": "`roleGrants()` — related root Project/Store с `$via` к subject, в запрошенных scopes, → `RoleContribution::of(role, AccessScope::in(tenant, AssignmentScopeRef(type, key)), source: id, origin: 'relation')`",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M6",
      "requirement": "`volatility()` — `Request`",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M7",
      "requirement": "`contextsCovering()` — `AssignmentScopeSelection::in(refs, raw contributions)`",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M8",
      "requirement": "ядро проверяет покрытие права ролью",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M9",
      "requirement": "проверки сборки: статичная роль существует в каталоге панели, `$via` — отношение модели (`BelongsToMany`/`HasMany`/`BelongsTo`/`HasOne`/`MorphToMany`), повтор `id()` — ошибка P2.5",
      "source_ref": "phases/P4.md:5"
    },
    {
      "id": "M10",
      "requirement": "вычисленный relation:<type> проходит IdentityCodec::assertSourceLabel на сборке, alias+prefix >128 → actionable DefinitionException (без runtime SourceError).",
      "source_ref": "phases/P4.md:5"
    }
  ],
  "never": [
    {
      "id": "N1",
      "prohibition": "Tenant-резолвинг сущности через `TenantPolicy`/`ModelAssignmentScopeDefinition` и фильтры областей (P4.6 — здесь tenant через resolve/ResolvedAssignmentScope",
      "source_ref": "phases/P4.md:6"
    },
    {
      "id": "N2",
      "prohibition": "tenantOf лишь queryable subtype)",
      "source_ref": "phases/P4.md:6"
    },
    {
      "id": "N3",
      "prohibition": "исполнение выбора в SQL видимости (P4.12)",
      "source_ref": "phases/P4.md:6"
    },
    {
      "id": "N4",
      "prohibition": "doctor `panels.relations` (P6.4)",
      "source_ref": "phases/P4.md:6"
    },
    {
      "id": "N5",
      "prohibition": "revision-контракт Stable (P4.8 — здесь только Request).",
      "source_ref": "phases/P4.md:6"
    }
  ],
  "done": {
    "public_acceptance": [
      {
        "id": "A1",
        "predicate": "`RelationSource` с ролями из связей и выбором сущностей; раздел P4.5 в `findings/P4-execution.md` (V69/V90 → тест; поддержанные типы отношений). Полная scoped source integration — P4.18, затем CRM P4.15 до P4.13; локальный source GREEN не подменяет её.",
        "scope": "public",
        "check": "1) `vendor/bin/pest tests/Feature/Sources/Relation` — GREEN; 2) `vendor/bin/pest tests/Feature/Authorization tests/Feature/Sources` — GREEN; 3) `vendor/bin/pest tests/Arch` — GREEN; 4) `php bin/api-manifest.php --check` — exit 0 после `composer api:manifest`; 5) `composer test`; 6) `vendor/bin/pint --test`; 7) `vendor/bin/phpstan analyse --memory-limit=1G`; 8) `php -d memory_limit=1G vendor/bin/pest --type-coverage --min=98`; 9) `git diff --check`.",
