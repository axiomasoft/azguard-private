+class ValidationArgvTests(unittest.TestCase):
+    def test_frozen_p45_numbered_validation_executes_only_nine_primary_commands(self):
+        # Exact Validation carrier from AZGuard P4.5, including its generation explanation.
+        carrier = (
+            "1) `vendor/bin/pest tests/Feature/Sources/Relation` — GREEN; "
+            "2) `vendor/bin/pest tests/Feature/Authorization tests/Feature/Sources` — GREEN; "
+            "3) `vendor/bin/pest tests/Arch` — GREEN; "
+            "4) `php bin/api-manifest.php --check` — exit 0 после `composer api:manifest`; "
+            "5) `composer test`; 6) `vendor/bin/pint --test`; "
+            "7) `vendor/bin/phpstan analyse --memory-limit=1G`; "
+            "8) `php -d memory_limit=1G vendor/bin/pest --type-coverage --min=98`; "
+            "9) `git diff --check`."
+        )
+        commands = [
+            "vendor/bin/pest tests/Feature/Sources/Relation",
+            "vendor/bin/pest tests/Feature/Authorization tests/Feature/Sources",
+            "vendor/bin/pest tests/Arch", "php bin/api-manifest.php --check",
+            "composer test", "vendor/bin/pint --test",
+            "vendor/bin/phpstan analyse --memory-limit=1G",
+            "php -d memory_limit=1G vendor/bin/pest --type-coverage --min=98",
+            "git diff --check",
+        ]
+        argv = plan_work._validation_argv(carrier)
+        self.assertEqual(argv, ["bash", "-lc", " && ".join(commands)])
+        self.assertNotIn("composer api:manifest", argv[2])
+
+    def test_numbered_commands_stop_before_later_checks_after_failure(self):
+        argv = plan_work._validation_argv("1) `printf first`; 2) `false`; 3) `printf unexecuted`.")
+        result = subprocess.run(argv, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(result.stdout, "first")
+
+    def test_numbering_and_clause_shape_fail_closed(self):
+        for carrier in (
+            "2) `first`", "1) `first`; 1) `duplicate`", "1) `first`; 3) `skipped`",
+            "01) `first`", "1) first", "1) ``", "1) `   `",
+            "1) `first`; echo undeclared", "1) `first` unexpected text",
+            "1) `first` — GREEN 2) `second` — GREEN",
+            "1) `first` — after `unclosed", "1) `first` —",
+        ):
+            with self.subTest(carrier=carrier), self.assertRaisesRegex(
+                    plan_work.WorkError, "PLAN_WORK_CHECKS_INVALID"):
+                plan_work._validation_argv(carrier)
+
+    def test_semicolon_in_command_and_explanatory_code_are_not_clause_boundaries(self):
+        carrier = "1) `printf 'a;b'` — GREEN после `ignored; annotation`; 2) `printf second` — GREEN;  "
+        argv = plan_work._validation_argv(carrier)
+        self.assertEqual(argv, ["bash", "-lc", "printf 'a;b' && printf second"])
+
