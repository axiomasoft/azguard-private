{
    "name": "axioma-studio/azguard-monorepo",
    "description": "Development monorepo for AzGuard — Laravel RBAC core, Filament UI, and multi-workspace context packages.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "axioma-studio/azguard-core": "^0.3",
        "axioma-studio/azguard-filament": "^0.3",
        "axioma-studio/azguard-context": "^0.3"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "rector/rector": "^2.0",
        "brianium/paratest": "^7.20",
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "AzGuard\\Tests\\": "tests/",
            "AzGuard\\Tests\\Stubs\\": "tests/Stubs/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "versions": {
                    "axioma-studio/azguard-core": "0.3.0",
                    "axioma-studio/azguard-filament": "0.3.0",
                    "axioma-studio/azguard-context": "0.3.0"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "php -d memory_limit=1G vendor/bin/pest",
        "test:parallel": "vendor/bin/pest --parallel --passthru-php='-d memory_limit=1G'",
        "test:coverage": "vendor/bin/pest --coverage --min=50",
        "test:unit": "vendor/bin/pest tests/Unit",
        "test:feature": "vendor/bin/pest tests/Feature",
        "test:api-snapshot": "vendor/bin/pest tests/Unit/ApiBoundaryTest.php",
        "test:api-snapshot:update": [
            "@putenv AZ_UPDATE_API_SNAPSHOT=1",
            "vendor/bin/pest tests/Unit/ApiBoundaryTest.php"
        ],
        "test:pgsql": [
            "@putenv DB_CONNECTION=pgsql",
            "php -d memory_limit=1G vendor/bin/pest"
        ],
        "test:mysql": [
            "@putenv DB_CONNECTION=mysql",
            "php -d memory_limit=1G vendor/bin/pest"
        ],
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test:types": "vendor/bin/pest --type-coverage --min=98",
        "check:coverage": "bash bin/coverage-gate.sh",
        "mutate": "bash bin/mutation-gate.sh",
        "mutate:core": "bash bin/mutation-gate.sh core",
        "mutate:filament": "bash bin/mutation-gate.sh filament",
        "mutate:context": "bash bin/mutation-gate.sh context",
        "mutate:all": "bash bin/mutation-gate.sh",
        "mutate:diff": "bash bin/mutation-gate.sh",
        "docs:parity": "bash bin/docs-parity-gate.sh",
        "docs:php": "bash bin/docs-php-version-gate.sh",
        "check": [
            "@lint:check",
            "@analyse",
            "@refactor:check",
            "@test:types",
            "@test",
            "@check:coverage",
            "@mutate:all"
        ],
        "fix": [
            "@lint",
            "@refactor"
        ]
    },
    "scripts-descriptions": {
        "check": "Run every CI gate locally: code style, static analysis, refactor dry-run, tests, coverage and mutation (both honest-skip without a coverage driver — see bin/*-gate.sh).",
        "fix": "Auto-fix code style (Pint) and apply Rector refactorings.",
        "mutate:all": "Run per-package native Pest mutation testing against fresh coverage.",
        "mutate:diff": "Run native Pest mutation checks; diff scoping is not supported by Pest mutate."
    }
}
