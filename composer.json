{
    "name": "axiomasoft/azguard-monorepo",
    "description": "Development monorepo for AzGuard: panel-based authorization core for Laravel and its Filament editors.",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Dmitry Vostrikov",
            "email": "dv.vostrikov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "axiomasoft/azguard": "^2.0",
        "axiomasoft/azguard-audit": "^2.0",
        "axiomasoft/azguard-filament": "^2.0",
        "axiomasoft/azguard-scopes": "^2.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-filament": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1"
    },
    "require-dev": {
        "axiomasoft/azguard-devtools": "^2.0",
        "axiomasoft/packman-devtools": "^0.1",
        "axiomasoft/packman-testkit": "^0.1",
        "brianium/paratest": "^7.20",
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.12",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32",
        "livewire/livewire": "^4.4.6",
        "orchestra/testbench": "^11.3",
        "orchestra/testbench-core": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "AzGuard\\Tests\\": "tests/",
            "AzGuardBench\\Load\\": "bench/src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/azguard": "2.0.0",
                    "axiomasoft/azguard-audit": "2.0.0",
                    "axiomasoft/azguard-devtools": "2.0.0",
                    "axiomasoft/azguard-filament": "2.0.0",
                    "axiomasoft/azguard-scopes": "2.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.x-dev",
                    "axiomasoft/packman-devtools": "0.1.x-dev",
                    "axiomasoft/packman-filament": "0.1.x-dev",
                    "axiomasoft/packman-modules": "0.1.x-dev",
                    "axiomasoft/packman-panels": "0.1.x-dev",
                    "axiomasoft/packman-plugins": "0.1.x-dev",
                    "axiomasoft/packman-schema": "0.1.x-dev",
                    "axiomasoft/packman-testkit": "0.1.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "process-timeout": 1200,
        "sort-packages": true
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "test": "php -d memory_limit=1G vendor/bin/pest --fail-on-skipped --exclude-group=pg --exclude-group=engines --exclude-group=redis --exclude-group=replica --exclude-group=extended --exclude-group=mysql-engines",
        "test:pg": "DB_CONNECTION=pgsql php -d memory_limit=1G vendor/bin/pest --group=pg",
        "gate": "@php vendor/bin/packman gate",
        "php-api": "@php vendor/bin/packman php-api --check",
        "error-codes": "@php vendor/bin/packman error-codes --check",
        "config-schema": "@php vendor/bin/packman config-schema --check",
        "ai:sync": "@php vendor/bin/packman ai:sync --dry-run",
        "test:parallel": "vendor/bin/pest --fail-on-skipped --exclude-group=pg --exclude-group=engines --exclude-group=redis --exclude-group=replica --exclude-group=extended --exclude-group=mysql-engines --parallel --processes=4 --passthru-php='-d memory_limit=1G'",
        "test:changed": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/test-changed.php"
        ],
        "test:unit": "php -d memory_limit=1G vendor/bin/pest tests/Unit",
        "test:feature": "php -d memory_limit=1G vendor/bin/pest tests/Feature --exclude-group=redis",
        "test:redis": "php -d memory_limit=1G vendor/bin/pest --ci --fail-on-skipped --group=redis",
        "test:replica": "bash tests/Engines/Support/replica-fixture.sh",
        "check:coverage": "bash bin/coverage-gate.sh",
        "bench": "php -d memory_limit=2G tests/Benchmarks/Suite.php --markdown",
        "bench:load": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=2G -d opcache.enable_cli=1 -d opcache.jit_buffer_size=0 bench/bin/run.php"
        ],
        "api:manifest": "php bin/api-manifest.php --write",
        "api:check": "php bin/api-manifest.php --check",
        "api:compat": "php bin/api-compat.php --against=auto",
        "docs:language": "bash bin/docs-language-gate.sh",
        "docs:php": "bash bin/docs-php-version-gate.sh",
        "check": [
            "@lint:check",
            "@analyse",
            "@refactor:check",
            "@gate",
            "@php-api",
            "@error-codes",
            "@config-schema",
            "@test"
        ],
        "fix": [
            "@lint",
            "@refactor"
        ],
        "test:extended": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=1G vendor/bin/pest --fail-on-skipped --group=extended"
        ],
        "test:db": [
            "Composer\\Config::disableProcessTimeout",
            "@php bin/test-db.php"
        ]
    },
    "scripts-descriptions": {
        "check": "Run required local gates: style, static analysis, Rector, Packman gates/contracts and tests.",
        "fix": "Auto-fix code style (Pint) and apply Rector refactorings.",
        "check:coverage": "Line coverage gate (--min=85) with an unlimited memory limit.",
        "bench": "Reproducible micro-benchmarks; prints a Markdown table (AZGUARD_BENCH_SAMPLES, default 300).",
        "bench:load": "Load bench (bench/README.md)",
        "test": "SQLite lane: every test except pg, engines, mysql-engines, redis, replica and the extended (scale) ones.",
        "test:pg": "PostgreSQL integration lane against azguard_test (--group=pg).",
        "test:parallel": "The SQLite lane on 4 ParaTest workers.",
        "test:changed": "Only the zones a change touches and the zones that use them (tests/zones.json); --quick, --db, --base=<ref>, --dry-run.",
        "test:db": "The database lane on one server: composer test:db -- <pgsql|mysql|mariadb> [--parallel[=N]] [--full] [--engines] [--zone=<zone>].",
        "test:extended": "The scale tests of group extended: nightly CI and before a release."
    },
    "extra": {
        "pest": {
            "plugins": [
                "AzGuard\\Tests\\Support\\PreserveRepeatedGroups"
            ]
        }
    }
}
