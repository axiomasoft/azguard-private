{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:azguard:trusted-producer:v1",
  "title": "Candidate trusted producer predicate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer_event", "workflow_sha", "source_sha", "split_sha", "tag", "run_id", "run_attempt", "zip_sha256", "source_sbom_sha256", "dependency_sbom_sha256", "mapping_sha256"],
  "properties": {
    "schema": {"const": "azguard.trusted-producer.v1"},
    "producer_event": {"const": "workflow_dispatch"},
    "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "split_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "run_attempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "zip_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_sbom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
