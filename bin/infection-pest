#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Infection selects its PHPUnit XML dialect from the executable's version. Pest
# reports its own version, so expose PHPUnit's version only for that probe.
if [[ "${1:-}" == "--version" ]]; then
    exec "${script_dir}/../vendor/bin/phpunit" --version
fi

exec "${script_dir}/../vendor/bin/pest" "$@"
